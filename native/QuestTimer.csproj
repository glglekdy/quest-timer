<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Quest Timer</AssemblyName>
    <RootNamespace>QuestTimer</RootNamespace>
    <Version>1.4.3</Version>
    <ApplicationIcon>../build/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Content Include="../src/**" Link="www/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/font/Inter/*.ttf" Link="www/assets/font/Inter/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/image/*.png" Link="www/assets/image/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../build/icon.ico" Link="icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

